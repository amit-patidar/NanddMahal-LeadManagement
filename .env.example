PORT=4000
DATABASE_PATH=./crm.sqlite

# Render PostgreSQL provides this automatically when you connect the database.
DATABASE_URL=

GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Nandd Mahal Leads

# Local development option: path to downloaded service account JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# Render option A: paste these from the service account JSON.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Render option B: paste the full service account JSON as one env var instead.
GOOGLE_SERVICE_ACCOUNT_JSON=

SYNC_INTERVAL_MINUTES=10

# WhatsApp Cloud API / Meta webhook setup.
WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WEBHOOK_REQUIRE_SIGNATURE=true

# Cloudinary media library for WhatsApp template header images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_WHATSAPP_FOLDER=nandd-mahal/whatsapp-headers
